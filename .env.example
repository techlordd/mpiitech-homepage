# Server only. Add these in Vercel > Project > Settings > Environment Variables.

# Admin dashboard (/admin). ADMIN_PASSWORD is required to sign in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional extra secret for signing admin sessions. Changing it signs everyone out.
ADMIN_SESSION_SECRET=

# Postgres database for settings, uploads, submissions and the email log.
# Adding a Neon database from the Vercel Marketplace sets this automatically.
DATABASE_URL=

# Email (Resend). These can also be set or overridden in Admin > Email & delivery log.
RESEND_API_KEY=
RESEND_FROM_EMAIL=MPIITECH <hello@your-verified-domain.com>
CONTACT_TO_EMAIL=

# Optional: the existing MPIITECH application / learning portal
NEXT_PUBLIC_PORTAL_URL=
